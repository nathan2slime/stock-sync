{
  "name": "service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm prisma:generate && rspack build",
    "check-types": "pnpm prisma:generate && tsc --noEmit --incremental false",
    "dev": "pnpm prisma:generate && cross-env NODE_ENV=development rspack --watch --mode development",
    "start": "node dist/main.cjs",
    "prisma:generate": "prisma generate",
    "lint": "rslint src",
    "test": "rstest run",
    "test:watch": "rstest watch"
  },
  "dependencies": {
    "@nestjs/common": "11.1.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "run-script-webpack-plugin": "0.2.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.9",
    "@rspack/cli": "2.1.4",
    "@rspack/core": "2.1.4",
    "@rspack/dev-server": "2.1.0",
    "@rstest/adapter-rspack": "^0.11.8",
    "@rstest/core": "^0.11.8",
    "@types/node": "^24.13.3",
    "cross-env": "10.1.0",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3",
    "webpack-node-externals": "3.0.0"
  }
}

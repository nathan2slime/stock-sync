{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "rsbuild dev",
    "build": "tsc && rsbuild build",
    "preview": "rsbuild preview",
    "lint": "rslint src tests",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "rstest run --config rstest.config.ts",
    "test:e2e": "pnpm build && rstest run --config rstest.e2e.config.ts",
    "test:watch": "rstest watch --config rstest.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-router": "^1.170.29",
    "antd": "^6.6.0",
    "dexie": "^4.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/rslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rsbuild/core": "2.1.11",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "^0.11.8",
    "@rstest/playwright": "^0.11.8",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}

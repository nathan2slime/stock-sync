{
  "extends": "@repo/typescript-config/rsbuild.json",
  "include": [
    "src",
    "tests",
    "rsbuild.config.ts",
    "rstest.config.ts",
    "rstest.e2e.config.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["@rsbuild/core/types", "node"]
  }
}
